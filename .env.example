# ============================================================
# F.R.I.D.A.Y. — Переменные окружения
# Скопируйте в .env и заполните нужные ключи: cp .env.example .env
# Файл .env добавлен в .gitignore и никогда не попадает в Git.
#
# ВАЖНО: F.R.I.D.A.Y. работает в режиме «Разведка + черновики»
# (без автоматической холодной рассылки — ст. 18 ФЗ «О рекламе»).
# Сбор с бесплатных источников (OSM РФ, DuckDuckGo RU, реестры и ваш CSV)
# работает вообще без ключей API.
# ============================================================

# ------------------------------------------------------------
# 1. ИСТОЧНИКИ РАЗВЕДКИ (DISCOVER) — все опциональны
# ------------------------------------------------------------

# Поиск Яндекса (Yandex Cloud Search API v2) — для органической выдачи и позиций 11-30
# Консоль: https://console.yandex.cloud → Yandex Search API
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Альтернатива для выдачи Яндекса: XML-прокси (XMLRiver / XMLStock и аналоги)
# Полный шаблон URL или базовый endpoint (например: https://xmlriver.com/search_yandex/xml?user=...&key=...)
YANDEX_XML_URL=

# Яндекс Карты (API Поиска по организациям)
# Кабинет разработчика: https://developer.tech.yandex.ru/services/3
YANDEX_MAPS_API_KEY=

# 2ГИС (Catalog / Places API 3.0) — карточки, рейтинг, отзывы, мессенджеры, наличие сайта
# Ключ: https://platform.2gis.ru
TWOGIS_API_KEY=

# ------------------------------------------------------------
# 2. ДВИЖОК АНАЛИЗА И ТЕКСТОВ (BRAIN)
# По умолчанию используется `claude` (Claude Code по подписке, без API-ключа).
# Если выбран `brain.provider: openai_compatible` в friday.yaml — укажите параметры ниже
# (подходит для OpenRouter, YandexGPT/GigaChat OpenAI-шлюза, DeepSeek, Qwen, локального Ollama/vLLM).
# Для режима `brain.provider: agent` (работа через ИИ-агента среды, например Arena/Cursor) ключи не нужны.
# ------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
