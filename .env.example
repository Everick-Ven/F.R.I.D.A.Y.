# ============================================================
# F.R.I.D.A.Y. — Переменные окружения (ВСЕ ОПЦИОНАЛЬНЫ)
# Скопируйте в .env при необходимости: cp .env.example .env
#
# Движок мышления (Brain) работает напрямую через ИИ-агента вашей
# рабочей среды (Arena.ai Agent Mode, Cursor, Windsurf, Claude Code) —
# никакие LLM API-ключи для анализа и написания черновиков НЕ нужны.
#
# Бесплатные источники разведки (HeadHunter api.hh.ru, OpenStreetMap РФ,
# веб-поиск DuckDuckGo RU и импорт CSV/списков) тоже работают БЕЗ ключей.
# ============================================================

# Поиск Яндекса (Yandex Cloud Search API v2) — для органической выдачи (позиции 1–30)
# Консоль: https://console.yandex.cloud → Yandex Search API
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Альтернатива для выдачи Яндекса: XML-прокси (XMLRiver / XMLStock и аналоги)
YANDEX_XML_URL=

# Яндекс Карты (API Поиска по организациям)
# Кабинет разработчика: https://developer.tech.yandex.ru/services/3
YANDEX_MAPS_API_KEY=

# 2ГИС (Catalog / Places API 3.0) — карточки бизнеса, рейтинг, отзывы, мессенджеры, сайт
# Ключ: https://platform.2gis.ru
TWOGIS_API_KEY=
